.vscode/settings.json
.vscode/launch.json
.mypy_cache/*
backend/__pycache__/*
backend/.mypy_cache/*
backend/config.json
.venv

# graphify - local-only cost log
graphify-out/cost.json
# graphify-out/cache/ intentionally tracked - small relative to repo size,
# saves real token cost by letting --update skip re-extracting unchanged files

# graphify - session-local timestamp (its mtime, not content, drives a strict-mode
# freshness check; a fresh clone's checkout-time mtime would falsely read as fresh)
graphify-out/cache/last_query_stamp

# graphify - machine-local interpreter path pointers (wrong on other machines)
graphify-out/.graphify_python
graphify-out/.graphify_root

# graphify - dated auto-backup, created automatically before overwriting a
# graph that cost real LLM tokens or has curated labels; git history already
# covers this, so committing it only accumulates clutter
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# graphify - install-time safety backup, not needed long-term
.claude/settings.json.graphify-bak
