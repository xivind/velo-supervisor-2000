{"nodes": [{"id": "claude_project_conventions", "label": "Velo Supervisor 2000 CLAUDE.md", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_communication_output_rules", "label": "Communication & Output Rules", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L20-L30", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_sub_agent_team", "label": "Sub-Agent Team", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L91-L112", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_standard_development_workflow", "label": "Standard Development Workflow", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L115-L205", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sequential handoff (product-manager -> ux-designer -> architect -> ux-designer v2 -> database-expert -> fullstack-developer -> code-reviewer -> docs-maintainer -> human) exists so UX and architecture stay coordinated before implementation, and so a human always reviews before commit."}, {"id": "claude_handover_communication", "label": "Agent Communication via Handovers", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L209-L256", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_git_workflow_rules", "label": "Git Workflow Rules", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L259-L296", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Agents never commit, push, or merge directly; all work is produced as artifacts for human review so architectural decisions stay human-approved even though handovers themselves are committed to git as decision records."}, {"id": "claude_code_style_standards", "label": "Code Style & Standards", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L299-L325", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_debugging_bug_fixing_rules", "label": "Debugging & Bug Fixing Rules", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L328-L334", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires tracing the bug through the full stack (route -> business logic -> database -> template -> JS) and ranking hypotheses by likelihood before editing code, to fix root causes instead of symptoms."}, {"id": "claude_change_management_rules", "label": "Change Management Rules", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L337-L344", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Favors the smallest change that solves the problem and requires enumerating all affected files (JS/CSS/template/Python) before cross-file refactors, to avoid partial or inconsistent changes."}, {"id": "claude_testing_requirements", "label": "Testing Requirements", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L348-L361", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_graphify_integration", "label": "graphify Integration Rules", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L384-L392", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "claude_project_conventions", "target": "claude_communication_output_rules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "L20", "weight": 1.0}, {"source": "claude_project_conventions", "target": "claude_sub_agent_team", "relation": "references", "confidence": "EXTRACTED", "confidence_score":